---
import BlogCard from '@/components/BlogCard.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import { buttonVariants } from '@/components/ui/button'
import { Separator } from '@/components/ui/separator'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getRecentPosts } from '@/lib/data-utils'

const blog = await getRecentPosts(SITE.featuredPostCount)
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Home" />
  <section class="rounded-xl border">
    <div class="flex flex-col space-y-1.5 p-6">
      <h2 class="font-mono text-3xl leading-none font-medium">bit·whys</h2>
      <p class="text-muted-foreground text-sm">
        /ˈbitˌ (h)wīz/ &bull; <span class="font-medium">computing</span>
      </p>
    </div>
    <!-- Definitions  -->
    <div class="p-6 pt-0">
      <div>
        <h3 class="text-muted-foreground">noun</h3>
        <p class="text-muted-foreground mb-2 pl-2 text-sm">
          <span class="text-foreground font-bold">
            a reason or <Link
              href="https://astro.build"
              class="text-foreground"
              external
              underline
            >
              explanation
            </Link>:
          </span> the whys and wherefores of these
          <Link
            href="https://astro.build"
            class="text-muted-foreground"
            external
            underline>procedures</Link
          > need to be explained to students.
        </p>
      </div>
      <div class="mt-4">
        <h2
          class="text-muted-foreground font-serif text-sm tracking-wide uppercase"
        >
          origin
        </h2>
        <Separator className="my-0.5" />
        <p class="text-muted-foreground pl-2 text-sm">
          Old English hwi, hwy 'by what cause' <Link
            href="https://github.com/jktrn/astro-erudite"
            class="text-foreground"
            underline
            external>GitHub</Link
          > repository. To learn more about why this template exists, read this blog
          post: <Link
            href="/blog/the-state-of-static-blogs"
            class="text-foreground"
            underline>The State of Static Blogs in 2024</Link
          >.
        </p>
      </div>
    </div>
  </section>
  <section class="flex flex-col gap-y-4">
    <h2 class="text-2xl font-medium">Latest posts</h2>
    <ul class="flex flex-col gap-y-4">
      {
        blog.map((post) => (
          <li>
            <BlogCard entry={post} />
          </li>
        ))
      }
    </ul>
    <div class="flex justify-center">
      <Link
        href="/blog"
        class={buttonVariants({ variant: 'ghost' }) + ' group'}
      >
        See all posts <span
          class="ml-1.5 transition-transform group-hover:translate-x-1"
          >&rarr;</span
        >
      </Link>
    </div>
  </section>
</Layout>
